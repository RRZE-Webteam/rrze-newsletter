{
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "johngrogg/ics-parser": "^3.4.1",
        "rlanvin/php-rrule": "^2.6.0",
        "html2text/html2text": "^4.3.2"
    },
    "suggest": {
        "ext-mbstring": "*",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-0": {
            "ICal": "src/"
        },
        "psr-4": {
            "RRZE\\Newsletter\\": "includes/",
            "RRule\\": "src/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:coverage": "@php -d pcov.enabled=1 -d pcov.directory=includes vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-text --coverage-filter includes"
    },
    "scripts-descriptions": {
        "test": "Run the complete test suite.",
        "test:unit": "Run the fast PHP unit tests.",
        "test:coverage": "Run the PHP unit tests and print a PCOV coverage report."
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
