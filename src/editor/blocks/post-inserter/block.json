{
	"name": "rrze-newsletter/post-inserter",
	"category": "widgets",
	"apiVersion": 3,
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"inserter": true
	},
	"attributes": {
		"areBlocksInserted": {
			"type": "boolean",
			"default": false
		},
		"postsToShow": {
			"type": "number",
			"default": 3
		},
		"preventDeduplication": {
			"type": "boolean",
			"default": false
		},
		"displayPostSubtitle": {
			"type": "boolean",
			"default": false
		},
		"displayAuthor": {
			"type": "boolean",
			"default": false
		},
		"displayPostExcerpt": {
			"type": "boolean",
			"default": true
		},
		"excerptLength": {
			"type": "number",
			"default": 15
		},
		"displayPostDate": {
			"type": "boolean",
			"default": false
		},
		"displayFeaturedImage": {
			"type": "boolean",
			"default": true
		},
		"displayContinueReading": {
			"type": "boolean",
			"default": true
		},
		"continueReadingStyle": {
			"type": "string",
			"enum": ["button", "link"],
			"default": "button"
		},
		"headingLevel": {
			"type": "number",
			"enum": [2, 3, 4, 5, 6],
			"default": 3
		},
		"displaySponsoredPosts": {
			"type": "boolean",
			"default": true
		},
		"innerBlocksToInsert": {
			"type": "array",
			"default": []
		},
		"featuredImageAlignment": {
			"type": "string",
			"default": "left"
		},
		"featuredImageSize": {
			"type": "string",
			"default": "large"
		},
		"isDisplayingSpecificPosts": {
			"type": "boolean",
			"default": false
		},
		"specificPosts": {
			"type": "array",
			"default": []
		},
		"textFontSize": {
			"type": "string"
		},
		"headingFontSize": {
			"type": "string"
		},
		"subHeadingFontSize": {
			"type": "string"
		},
		"textColor": {
			"type": "string"
		},
		"headingColor": {
			"type": "string"
		},
		"subHeadingColor": {
			"type": "string"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"tags": {
			"type": "array",
			"default": []
		},
		"tagExclusions": {
			"type": "array",
			"default": []
		},
		"categories": {
			"type": "array",
			"default": []
		},
		"categoryExclusions": {
			"type": "array",
			"default": []
		}
	}
}
